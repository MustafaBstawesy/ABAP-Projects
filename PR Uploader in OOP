*&---------------------------------------------------------------------*
REPORT ZMM_PR_UPLOADER.

CLASS ZCL_PR_CREATOR DEFINITION.

  PUBLIC SECTION.
    TYPES: BEGIN OF TY_PR_DATA,
             " PR_DOC_TYPE      TYPE STRING,
             PR_NUMBER       TYPE STRING,
             PR_LINE_ITEM    TYPE STRING,
             PR_SHORT_TEXT   TYPE STRING,
             PR_LONG_TEXT    TYPE STRING,
             TRACKING_NUMBER TYPE STRING,
             MATERIAL_GROUP  TYPE STRING,
             WBS             TYPE STRING,
             SERVICE_SERIAL  TYPE STRING,
             SERVICE_SHORT   TYPE STRING,
             QUANTITY        TYPE STRING,
             UOM             TYPE STRING,
             PRICE_UNIT      TYPE STRING,
           END OF TY_PR_DATA.

    DATA: IT_RAW_DATA       TYPE TRUXS_T_TEXT_DATA,
          IT_CONVERTED_DATA TYPE STANDARD TABLE OF TY_PR_DATA.

    METHODS:
      EXECUTE IMPORTING I_FILENAME TYPE RLGRAP-FILENAME.

  PRIVATE SECTION.
    DATA: PRHEADER        TYPE BAPIMEREQHEADER,
          PRHEADERX       TYPE BAPIMEREQHEADERX,
          PRITEM          TYPE STANDARD TABLE OF BAPIMEREQITEMIMP,
          PRITEMX         TYPE STANDARD TABLE OF BAPIMEREQITEMX,
          PRACCOUNT       TYPE STANDARD TABLE OF BAPIMEREQACCOUNT,
          PRACCOUNTX      TYPE STANDARD TABLE OF BAPIMEREQACCOUNTX,
          PRITEMTEXT      TYPE STANDARD TABLE OF BAPIMEREQITEMTEXT,
          SERVICELINES    TYPE STANDARD TABLE OF BAPI_SRV_SERVICE_LINE,
          SERVICELINESX   TYPE STANDARD TABLE OF BAPI_SRV_SERVICE_LINEX,
          SERVICEACCOUNT  TYPE STANDARD TABLE OF BAPI_SRV_ACC_DATA,
          SERVICEACCOUNTX TYPE STANDARD TABLE OF BAPI_SRV_ACC_DATAX,
          RETURN          TYPE STANDARD TABLE OF BAPIRET2.

    DATA: WA_RETURN         TYPE BAPIRET2.
    "DATA: COUNTER TYPE I.

    TYPE-POOLS: SLIS.

    TYPES: BEGIN OF TY_PR_ERROR,
             PR_DOC_TYPE TYPE CHAR4,
             TYPE        TYPE BAPIRET2-MESSAGE,
             ROW         TYPE CHAR10,
             MESSAGE     TYPE BAPIRET2-MESSAGE,
             PR_NUMBER   TYPE CHAR10,
           END OF TY_PR_ERROR.

    DATA: GT_PR_STATUS  TYPE STANDARD TABLE OF TY_PR_ERROR,
          GT_TEMP_TABLE TYPE STANDARD TABLE OF TY_PR_ERROR,
          GS_PR_ERROR   TYPE TY_PR_ERROR.

    DATA: GT_FIELDCAT TYPE SLIS_T_FIELDCAT_ALV,
          GS_FIELDCAT TYPE SLIS_FIELDCAT_ALV.

    METHODS:
      UPLOAD_EXCEL IMPORTING I_FILENAME TYPE RLGRAP-FILENAME,
      PREPARE_PR_DATA,
      CREATE_PR IMPORTING I_PR_DOC_TYPE TYPE CHAR4,
      FILL_PR_STATUS_TABLE IMPORTING I_PR_DOC_TYPE TYPE CHAR4,
      BUILD_FIELDCAT,
      DISPLAY_ALV,
      DISPLAY_STATUS.

ENDCLASS.

CLASS ZCL_PR_CREATOR IMPLEMENTATION.

  METHOD UPLOAD_EXCEL.
    CALL FUNCTION 'TEXT_CONVERT_XLS_TO_SAP'
      EXPORTING
        I_LINE_HEADER        = 'X'
        I_TAB_RAW_DATA       = IT_RAW_DATA
        I_FILENAME           = I_FILENAME
      TABLES
        I_TAB_CONVERTED_DATA = IT_CONVERTED_DATA
      EXCEPTIONS
        CONVERSION_FAILED    = 1
        OTHERS               = 2.

    IF SY-SUBRC <> 0.
      MESSAGE 'Excel conversion failed' TYPE 'E'.
    ENDIF.
  ENDMETHOD.

  METHOD PREPARE_PR_DATA.

    DATA: WA_PRITEM          TYPE BAPIMEREQITEMIMP,
          WA_PRITEMX         TYPE BAPIMEREQITEMX,
          WA_PRACCOUNT       TYPE BAPIMEREQACCOUNT,
          WA_PRACCOUNTX      TYPE BAPIMEREQACCOUNTX,
          WA_PRITEMTEXT      TYPE BAPIMEREQITEMTEXT,
          WA_SERVICELINE     TYPE BAPI_SRV_SERVICE_LINE,
          WA_SERVICELINEX    TYPE BAPI_SRV_SERVICE_LINEX,
          WA_SERVICEACCOUNT  TYPE BAPI_SRV_ACC_DATA,
          WA_SERVICEACCOUNTX TYPE BAPI_SRV_ACC_DATAX.

    DATA(MAIN_TABLE)    = IT_CONVERTED_DATA.
    DATA(ITEM_TABLE)    = IT_CONVERTED_DATA.
    DATA(SERVICE_TABLE) = IT_CONVERTED_DATA.

    SORT MAIN_TABLE ASCENDING BY PR_NUMBER.
    SORT ITEM_TABLE ASCENDING BY PR_NUMBER PR_LINE_ITEM.

    DELETE ADJACENT DUPLICATES FROM MAIN_TABLE COMPARING PR_NUMBER.
    DELETE ADJACENT DUPLICATES FROM ITEM_TABLE COMPARING PR_NUMBER PR_LINE_ITEM.

    REFRESH: PRACCOUNT, PRACCOUNTX, SERVICELINES, SERVICELINESX, SERVICEACCOUNT, SERVICEACCOUNTX, PRITEM, PRITEMX, PRITEMTEXT.
    CLEAR: PRHEADER, PRHEADERX.

    LOOP AT MAIN_TABLE ASSIGNING FIELD-SYMBOL(<MAIN>).
      CLEAR: PRHEADER, PRHEADERX.

      PRHEADER-PR_TYPE = 'ZAUT'.
      "PRHEADER-PR_TYPE = <MAIN>-PR_DOC_TYPE.
      PRHEADERX-PR_TYPE = 'X'.


      LOOP AT ITEM_TABLE ASSIGNING FIELD-SYMBOL(<ITEM>) WHERE PR_NUMBER = <MAIN>-PR_NUMBER.

        CLEAR: WA_PRITEM, WA_PRITEMX, WA_PRITEMTEXT.

        " PR Item
        WA_PRITEM-PREQ_ITEM   = <ITEM>-PR_LINE_ITEM.
        WA_PRITEM-PUR_GROUP   = '001'. " Example Purchasing Group
        WA_PRITEM-SHORT_TEXT  = <ITEM>-PR_SHORT_TEXT.
        WA_PRITEM-PLANT       = '1100'.
        WA_PRITEM-TRACKINGNO  = <ITEM>-TRACKING_NUMBER.
        WA_PRITEM-MATL_GROUP  = <ITEM>-MATERIAL_GROUP.
        WA_PRITEM-ITEM_CAT    = '9'.
        WA_PRITEM-ACCTASSCAT  = 'H'.
        APPEND WA_PRITEM TO PRITEM.

        WA_PRITEMX-PREQ_ITEM  = <ITEM>-PR_LINE_ITEM.
        WA_PRITEMX-PREQ_ITEMX = 'X'.
        WA_PRITEMX-PUR_GROUP  = 'X'.
        WA_PRITEMX-SHORT_TEXT = 'X'.
        WA_PRITEMX-PLANT      = 'X'.
        WA_PRITEMX-TRACKINGNO = 'X'.
        WA_PRITEMX-MATL_GROUP = 'X'.
        WA_PRITEMX-ITEM_CAT   = 'X'.
        WA_PRITEMX-ACCTASSCAT = 'X'.
        APPEND WA_PRITEMX TO PRITEMX.

        """********* PRITEM - PRITEMX *********"""

        WA_PRITEMTEXT-PREQ_ITEM = <ITEM>-PR_LINE_ITEM.
        WA_PRITEMTEXT-TEXT_ID   = 'B01'. " Item text ID
        WA_PRITEMTEXT-TEXT_LINE = <ITEM>-PR_LONG_TEXT.
        APPEND WA_PRITEMTEXT TO PRITEMTEXT.

        """********* PRITEMTEXT *********"""

        DATA: COUNTER TYPE I VALUE 0.
        CLEAR COUNTER.

        LOOP AT SERVICE_TABLE ASSIGNING FIELD-SYMBOL(<SERVICE>) WHERE PR_NUMBER = <ITEM>-PR_NUMBER AND PR_LINE_ITEM = <ITEM>-PR_LINE_ITEM.

          CLEAR: WA_PRACCOUNT, WA_PRACCOUNTX, WA_SERVICELINE, WA_SERVICELINEX, WA_SERVICEACCOUNT, WA_SERVICEACCOUNTX.

          COUNTER += 1.

          WA_PRACCOUNT-PREQ_ITEM     = <ITEM>-PR_LINE_ITEM.
          WA_PRACCOUNT-WBS_ELEMENT   = <SERVICE>-WBS.
          WA_PRACCOUNT-SERIAL_NO     = COUNTER.
          APPEND WA_PRACCOUNT TO PRACCOUNT.

          WA_PRACCOUNTX-PREQ_ITEM    = <ITEM>-PR_LINE_ITEM.
          WA_PRACCOUNTX-PREQ_ITEMX   = 'X'.
          WA_PRACCOUNTX-WBS_ELEMENT  = 'X'.
          WA_PRACCOUNTX-SERIAL_NO    = COUNTER.
          WA_PRACCOUNTX-SERIAL_NOX   = 'X'.
          APPEND WA_PRACCOUNTX TO PRACCOUNTX.

          """********* PRACCOUNT - PRACCOUNTX *********"""

          WA_SERVICELINE-SRV_LINE   = <SERVICE>-SERVICE_SERIAL.
          WA_SERVICELINE-SHORT_TEXT = <SERVICE>-SERVICE_SHORT.
          WA_SERVICELINE-QUANTITY   = <SERVICE>-QUANTITY.
          WA_SERVICELINE-UOM        = <SERVICE>-UOM.
          WA_SERVICELINE-GROSS_PRICE = <SERVICE>-PRICE_UNIT.
          WA_SERVICELINE-DOC_ITEM   = <SERVICE>-PR_LINE_ITEM.
          WA_SERVICELINE-OUTLINE    = '0000000001'.
          WA_SERVICELINE-CURRENCY   = 'EGP'.
          APPEND WA_SERVICELINE TO SERVICELINES.

          WA_SERVICELINEX-SRV_LINE   = <SERVICE>-SERVICE_SERIAL.
          WA_SERVICELINEX-SHORT_TEXT = 'X'.
          WA_SERVICELINEX-QUANTITY   = 'X'.
          WA_SERVICELINEX-UOM        = 'X'.
          WA_SERVICELINEX-GROSS_PRICE = 'X'.
          WA_SERVICELINEX-DOC_ITEM   = <SERVICE>-PR_LINE_ITEM.
          WA_SERVICELINEX-OUTLINE    = '0000000001'.
          WA_SERVICELINEX-CURRENCY   = 'X'.
          APPEND WA_SERVICELINEX TO SERVICELINESX.

          """********* SERVICELINE - SERVICELINEX *********"""

          WA_SERVICEACCOUNT-DOC_ITEM       = <SERVICE>-PR_LINE_ITEM.
          WA_SERVICEACCOUNT-OUTLINE        = '0000000001'.
          WA_SERVICEACCOUNT-SRV_LINE       = <SERVICE>-SERVICE_SERIAL.
          WA_SERVICEACCOUNT-SERIAL_NO      = COUNTER.
          WA_SERVICEACCOUNT-SERIAL_NO_ITEM = COUNTER.
          WA_SERVICEACCOUNT-PERCENT        = '100'.
          APPEND WA_SERVICEACCOUNT TO SERVICEACCOUNT.

          WA_SERVICEACCOUNTX-DOC_ITEM       = <SERVICE>-PR_LINE_ITEM.
          WA_SERVICEACCOUNTX-OUTLINE        = '0000000001'.
          WA_SERVICEACCOUNTX-SRV_LINE       = <SERVICE>-SERVICE_SERIAL.
          WA_SERVICEACCOUNTX-SERIAL_NO      = COUNTER.
          WA_SERVICEACCOUNTX-SERIAL_NO_ITEM = 'X'.
          WA_SERVICEACCOUNTX-PERCENT        = 'X'.
          APPEND WA_SERVICEACCOUNTX TO SERVICEACCOUNTX.

          """********* SERVICEACCOUNT *********"""
        ENDLOOP.

      ENDLOOP.
      BREAK SOLEX_ABAP03.
      ME->CREATE_PR( I_PR_DOC_TYPE = PRHEADER-PR_TYPE ).

    ENDLOOP.

  ENDMETHOD.

  METHOD CREATE_PR.
    CALL FUNCTION 'BAPI_PR_CREATE'
      EXPORTING
        PRHEADER        = PRHEADER
        PRHEADERX       = PRHEADERX
      TABLES
        RETURN          = RETURN
        PRITEM          = PRITEM
        PRITEMX         = PRITEMX
        PRACCOUNT       = PRACCOUNT
        PRACCOUNTX      = PRACCOUNTX
        PRITEMTEXT      = PRITEMTEXT
        SERVICELINES    = SERVICELINES
        SERVICELINESX   = SERVICELINESX
        SERVICEACCOUNT  = SERVICEACCOUNT
        SERVICEACCOUNTX = SERVICEACCOUNTX.

    READ TABLE RETURN TRANSPORTING NO FIELDS WITH KEY TYPE = 'E'.
    IF SY-SUBRC = 0.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      MESSAGE 'PR creation failed. Check return messages.' TYPE 'E'.

      ME->FILL_PR_STATUS_TABLE( I_PR_DOC_TYPE = I_PR_DOC_TYPE ).

    ELSE.   

      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          WAIT = 'X'.
      MESSAGE 'PR created successfully.' TYPE 'S'.

      ME->FILL_PR_STATUS_TABLE( I_PR_DOC_TYPE = I_PR_DOC_TYPE ).

    ENDIF.
  ENDMETHOD.

  METHOD FILL_PR_STATUS_TABLE.


      MOVE-CORRESPONDING RETURN TO GT_TEMP_TABLE.

      DELETE GT_TEMP_TABLE WHERE  TYPE <> 'E' AND TYPE <> 'S'.

      READ TABLE RETURN ASSIGNING FIELD-SYMBOL(<ROW>) WITH KEY TYPE = 'S'.

      LOOP AT GT_TEMP_TABLE ASSIGNING FIELD-SYMBOL(<WA>).
        <WA>-PR_DOC_TYPE = I_PR_DOC_TYPE.
        <WA>-PR_NUMBER   = <ROW>-MESSAGE_V2.
      ENDLOOP.

      APPEND LINES OF GT_TEMP_TABLE TO GT_PR_STATUS.

      APPEND INITIAL LINE TO GT_PR_STATUS.

      REFRESH GT_TEMP_TABLE.

      CLEAR <ROW>.

  ENDMETHOD.

  METHOD BUILD_FIELDCAT.

    DEFINE ADD_FIELD.
      CLEAR gs_fieldcat.
      gs_fieldcat-fieldname = &1.
      gs_fieldcat-seltext_m = &2.
      APPEND gs_fieldcat TO gt_fieldcat.
    END-OF-DEFINITION.

    ADD_FIELD 'PR_DOC_TYPE'     'PR Number'.
    ADD_FIELD 'TYPE'            'Type'.
    ADD_FIELD 'MESSAGE'         'Message'.
    ADD_FIELD 'ROW'             'Row'.
    ADD_FIELD 'PR_NUMBER'       'PR Number'.

  ENDMETHOD.

  METHOD DISPLAY_ALV.

    CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
      EXPORTING
        I_STRUCTURE_NAME = 'TY_PR_ERROR'
        IT_FIELDCAT      = GT_FIELDCAT
      TABLES
        T_OUTTAB         = GT_PR_STATUS.

  ENDMETHOD.

  METHOD DISPLAY_STATUS.

    ME->BUILD_FIELDCAT( ).
    ME->DISPLAY_ALV( ).

  ENDMETHOD.

  METHOD EXECUTE.

    ME->UPLOAD_EXCEL( I_FILENAME = I_FILENAME ).
    ME->PREPARE_PR_DATA( ).
    ME->DISPLAY_STATUS( ).

  ENDMETHOD.

ENDCLASS.

" ----------- SELECTION SCREEN HANDLER -------------- "

PARAMETERS: P_FILE TYPE RLGRAP-FILENAME OBLIGATORY.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR P_FILE.
  CALL FUNCTION 'F4_FILENAME'
    EXPORTING
      PROGRAM_NAME = SYST-CPROG
      FIELD_NAME   = 'P_FILE'
    IMPORTING
      FILE_NAME    = P_FILE.

START-OF-SELECTION.
  BREAK SOLEX_ABAP03.
  DATA(LO_PR_CREATOR) = NEW ZCL_PR_CREATOR( ).

  LO_PR_CREATOR->EXECUTE( I_FILENAME = P_FILE ).
